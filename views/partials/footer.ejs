  <!-- Footer Guide Button Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const footerGuideBtn = document.getElementById('footerGuideBtn');
      const footerOnboardingBtn = document.getElementById('footerOnboardingBtn');
      const globalGuideModal = document.getElementById('globalGuideModal');
      const closeGlobalGuideModal = document.getElementById('closeGlobalGuideModal');
      
      // Function to open guide modal
      function openGuideModal() {
        if (globalGuideModal) {
          globalGuideModal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      }
      
      // Function to close guide modal
      function closeGuideModal() {
        if (globalGuideModal) {
          globalGuideModal.style.display = 'none';
          document.body.style.overflow = '';
        }
      }
      
      // Both footer buttons open the same guide modal
      if (footerGuideBtn) {
        footerGuideBtn.addEventListener('click', function(e) {
          e.preventDefault();
          openGuideModal();
        });
      }
      
      if (footerOnboardingBtn) {
        footerOnboardingBtn.addEventListener('click', function(e) {
          e.preventDefault();
          openGuideModal();
        });
      }
      
      // Close guide modal
      if (closeGlobalGuideModal) {
        closeGlobalGuideModal.addEventListener('click', function(e) {
          e.preventDefault();
          closeGuideModal();
        });
      }
      
      // Close on background click
      if (globalGuideModal) {
        globalGuideModal.addEventListener('click', function(e) {
          if (e.target === globalGuideModal) {
            closeGuideModal();
          }
        });
      }
      
      // Close on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && globalGuideModal && globalGuideModal.style.display === 'flex') {
          closeGuideModal();
        }
      });
    });
  </script>

