          response = faqResponses['How do I update my profile?'];
        } else if (question.includes('volume') || question.includes('trading volume')) {
          response = faqResponses['What is volume in trading?'];
        } else if (question.includes('history') || question.includes('transactions') || question.includes('past') || question.includes('record')) {
