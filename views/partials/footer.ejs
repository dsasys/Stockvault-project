      // Function to add message to chat
      function addMessage(message, isUser = false) {
        const messageDiv = document.createElement('div');
        messageDiv.style.display = 'flex';
        messageDiv.style.gap = '8px';
        messageDiv.style.alignItems = 'flex-start';

        if (isUser) {
          messageDiv.style.justifyContent = 'flex-end';
          messageDiv.innerHTML = `
            <div style="background: linear-gradient(135deg, #4f8cff 0%, #38d39f 100%); color: #fff; padding: 12px; border-radius: 12px; max-width: 80%;">
              <p style="margin: 0; font-size: 0.9em;">${message}</p>
            </div>
            <div style="width: 32px; height: 32px; background: #f0f4ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #4f8cff; font-size: 0.8em;">
              <i class="fas fa-user"></i>
            </div>
          `;
        } else {
          messageDiv.innerHTML = `
            <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #4f8cff 0%, #38d39f 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.8em;">
              <i class="fas fa-robot"></i>
            </div>
            <div style="background: #f0f4ff; padding: 12px; border-radius: 12px; max-width: 80%;">
              <p style="margin: 0; font-size: 0.9em; color: #333;">${message}</p>
            </div>
          `;
        }

        chatMessages.appendChild(messageDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      // Function to handle user input with enhanced keyword recognition
      function handleUserInput(input) {
        const question = input.toLowerCase();
        let response = '';

        // Enhanced keyword matching with multiple variations
        if (question.includes('buy') || question.includes('purchase') || question.includes('buying') || question.includes('acquire')) {
          response = faqResponses['How do I buy stocks?'];
        } else if (question.includes('portfolio') || question.includes('holdings') || question.includes('investments') || question.includes('my stocks')) {
          response = faqResponses['How do I check my portfolio?'];
        } else if (question.includes('wallet') || question.includes('money') || question.includes('deposit') || question.includes('add funds') || question.includes('funding')) {
          response = faqResponses['How do I add money to my wallet?'];
        } else if (question.includes('p/l') || question.includes('profit') || question.includes('loss') || question.includes('gain') || question.includes('earnings')) {
          response = faqResponses['What is P/L?'];
