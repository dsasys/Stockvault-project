          response = faqResponses['How do I sell stocks?'];
        } else if (question.includes('performance') || question.includes('track') || question.includes('returns') || question.includes('how am i doing')) {
          response = faqResponses['How do I track my performance?'];
        } else if (question.includes('hours') || question.includes('time') || question.includes('when') || question.includes('schedule')) {
