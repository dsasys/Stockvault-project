      // Toggle chatbot
      if (chatbotToggle && chatbotModal) {
        chatbotToggle.addEventListener('click', function() {
          chatbotModal.style.display = chatbotModal.style.display === 'none' ? 'flex' : 'none';
        });

        closeChatbot.addEventListener('click', function() {
          chatbotModal.style.display = 'none';
        });
      }

      // Handle FAQ button clicks
      faqButtons.forEach(button => {
        button.addEventListener('click', function() {
          const question = this.getAttribute('data-question');
          const response = faqResponses[question];
          
          addMessage(question, true);
          setTimeout(() => addMessage(response), 500);
        });
      });

      // Handle send message
      if (sendMessage && chatInput) {
        sendMessage.addEventListener('click', function() {
          const message = chatInput.value.trim();
          if (message) {
            handleUserInput(message);
            chatInput.value = '';
          }
        });

        // Handle Enter key
        chatInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            const message = chatInput.value.trim();
            if (message) {
              handleUserInput(message);
              chatInput.value = '';
            }
          }
        });

        // Mobile touch support for input
        chatInput.addEventListener('touchstart', function(e) {
          // Prevent zoom on mobile
          e.preventDefault();
        }, { passive: false });

        // Auto-focus on mobile when chat opens
        if (chatbotModal) {
          chatbotModal.addEventListener('shown', function() {
            if (window.innerWidth <= 768) {
              setTimeout(() => chatInput.focus(), 300);
            }
          });
        }
      }

      // Enhanced mobile support
      if (chatbotModal) {
        // Prevent body scroll when chat is open on mobile
        chatbotModal.addEventListener('touchmove', function(e) {
          e.stopPropagation();
        }, { passive: false });

        // Close chat on swipe down (mobile gesture)
        let startY = 0;
        let currentY = 0;

        chatbotModal.addEventListener('touchstart', function(e) {
          startY = e.touches[0].clientY;
        }, { passive: true });

        chatbotModal.addEventListener('touchmove', function(e) {
          currentY = e.touches[0].clientY;
          const diff = startY - currentY;
          
          // If swiped down more than 100px, close chat
          if (diff > 100) {
            chatbotModal.style.display = 'none';
          }
        }, { passive: true });
      }

      // Add drag-to-identify functionality for FAQ buttons
      faqButtons.forEach(button => {
        // Add visual feedback on touch
        button.addEventListener('touchstart', function() {
          this.style.transform = 'scale(0.95)';
          this.style.opacity = '0.8';
        }, { passive: true });

        button.addEventListener('touchend', function() {
          this.style.transform = 'scale(1)';
          this.style.opacity = '1';
        }, { passive: true });

        // Add hover effect for desktop
        button.addEventListener('mouseenter', function() {
          this.style.transform = 'scale(1.05)';
          this.style.boxShadow = '0 4px 12px rgba(79,140,255,0.3)';
        });

        button.addEventListener('mouseleave', function() {
          this.style.transform = 'scale(1)';
          this.style.boxShadow = 'none';
        });
      });
    });
  </script>
</body>
</html>

